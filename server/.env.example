# Copy to .env and fill in. .env is never committed.

# PostgreSQL connection for the app user (created by scripts/create-db.sql)
DATABASE_URL=postgres://gym_app:CHANGE_ME@localhost:5432/gym

# HTTP port of the API
PORT=3000

# development | production
NODE_ENV=development

# Optional: make this account an admin with this password at server start (see docs/DEPLOY.md).
# Remove ADMIN_PASSWORD after signing in: while set, every restart resets the password to it.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
